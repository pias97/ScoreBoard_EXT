{
  "manifest_version": 3,
  "name": "WC26 Live — BD Time",
  "version": "1.1.0",
  "description": "FIFA World Cup 2026 live scores, goal scorers & stats. Kickoffs in Bangladesh time.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://site.api.espn.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "World Cup 2026 Live"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
